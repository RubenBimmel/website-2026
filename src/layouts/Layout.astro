---
interface Props {
	title?: string;
}

const { title } = Astro.props;

const pageTitle = title ? `Ruben Bimmel | ${title}` : 'Ruben Bimmel';
---

<!doctype html>
<html lang="nl">
	<head>
		<meta name="robots" content="noindex, follow, noarchive, nosnippet, max-image-preview:none">
		<meta name="googlebot" content="noindex, follow">
		<meta name="description" content="Full content coming soon.">
		<meta http-equiv="cache-control" content="no-cache, no-store, must-revalidate">
		<meta http-equiv="expires" content="0">
		<meta http-equiv="pragma" content="no-cache">

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<title>{pageTitle}</title>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Molengo&display=swap" rel="stylesheet">
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;

		font-family: "Molengo", sans-serif;
		font-weight: 400;
		font-style: normal;
	}
</style>
