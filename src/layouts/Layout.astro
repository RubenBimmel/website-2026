---
import '../styles/reset.css';

interface Props {
	title?: string;
}

const { title } = Astro.props;

const pageTitle = title ? `Ruben Bimmel | ${title}` : 'Ruben Bimmel';
---

<!doctype html>
<html lang="nl">
	<head>
		<meta name="robots" content="noindex, follow, noarchive, nosnippet, max-image-preview:none">
		<meta name="googlebot" content="noindex, follow">
		<meta name="description" content="Full content coming soon.">
		<meta http-equiv="cache-control" content="no-cache, no-store, must-revalidate">
		<meta http-equiv="expires" content="0">
		<meta http-equiv="pragma" content="no-cache">

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<title>{pageTitle}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style lang="scss">
	@import url('https://fonts.googleapis.com/css2?family=Nokora:wght@100..900&family=Playpen+Sans:wght@100&display=swap');

	html {
		--max-content-width: 1080px;
		--background: rgb(230, 230, 230);
		--foreground: black;
		--panel: rgba(0, 0, 0, 0.8);
		--on-panel: rgb(230, 230, 230);
		
		--color-brick: #FAE9E6;
		--color-ocher: #FAF3D9;
		--color-moss: #F0F6ED;

		color: var(--foreground);
		background-color: var(--background);
		scroll-snap-type: y proximity;

		@media (prefers-color-scheme: dark) {
			--background: black;
			--foreground: rgb(230, 230, 230);
			--panel: rgba(230, 230, 230, 0.8);
			--on-panel: black;

			--color-brick: #2B1815;
			--color-ocher: #2E2412;
			--color-moss: #182016;
		}

		@media (prefers-reduced-motion: no-preference) {
			scroll-behavior: smooth;
		}
	}

	body {
		margin: 0;
		width: 100%;
		height: 100%;

		font-family: "Nokora", sans-serif;
		font-optical-sizing: auto;
		font-weight: 400;
		font-style: normal;
	}
</style>
