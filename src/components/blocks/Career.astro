---
import Section from "../shared/Section.astro";
import Typography from "../shared/Typography.astro";
import Timeline from "../shared/Timeline.astro";
import Link from "../shared/Link.astro";
import TagList from "../shared/TagList.astro";
import Tag from "../shared/Tag.astro";
---

<Section id="career" color="var(--color-ocher)">
    <Typography as="h1" variant="title">Werk</Typography>
    <Timeline date="2019 - 2026">
        <Typography as="h2" variant="heading">Frontend Developer</Typography>
        <Link to="https://www.q42.nl/">Q42</Link>
        <hr/>
        <div class="project">
            <div>
                <Typography as="h3" variant="subheading">Secrid Graveertool</Typography>
                <Link to="https://customise.secrid.com/">https://customise.secrid.com/</Link>
            </div>
            <TagList>
                <Tag>Next.js</Tag>
                <Tag>Typescript</Tag>
                <Tag>Tailwind</Tag>
                <Tag>Three.js</Tag>
                <Tag>Storyblok</Tag>
            </TagList>
        </div>
        <hr/>
        <div class="project">
            <div>
                <Typography as="h3" variant="subheading">Oculi Mundi</Typography>
                <Link to="https://oculi-mundi.com/">https://oculi-mundi.com/</Link>
            </div>
            <TagList>
                <Tag>Next.js</Tag>
                <Tag>Typescript</Tag>
                <Tag>Tailwind</Tag>
                <Tag>Sanity</Tag>
            </TagList>
        </div>
        <hr/>
        <div class="project">
            <div>
                <Typography as="h3" variant="subheading">De Jurk en het Scheepswrak</Typography>
                <Link to="https://duikmee.dejurkenhetscheepswrak.nl/">https://duikmee.dejurkenhetscheepswrak.nl/</Link>
            </div>
            <TagList>
                <Tag>Svelte</Tag>
                <Tag>Typescript</Tag>
                <Tag>Three.js</Tag>
            </TagList>
        </div>
        <hr/>
        <div class="project">
            <div>
                <Typography as="h3" variant="subheading">42 Puzzles</Typography>
                <Link to="https://www.42puzzles.com/">https://www.42puzzles.com/</Link>
            </div>
            <TagList>
                <Tag>Svelte</Tag>
                <Tag>Typescript</Tag>
                <Tag>AWS Compute</Tag>
            </TagList>
        </div>
    </Timeline>
    <Timeline date="2018 - 2019">
        <Typography as="h2" variant="heading">Game Development Intern</Typography>
        <Link to="https://www.turtleblaze.com/">TurtleBlaze</Link>
        <hr/>
        <div class="project">
            <div>
                <Typography as="h3" variant="subheading">Kunai</Typography>
                <Link to="https://www.kunaigame.com/">https://www.kunaigame.com/</Link>
            </div>
            <TagList>
                <Tag>Unity</Tag>
            </TagList>
        </div>
    </Timeline>
    <Timeline date="2013 - 2018">
        <Typography as="h2" variant="heading">Content Management & Desktoppublishing</Typography>
        <Link to="https://weststrate.nl/">Weststrate VOF</Link>
    </Timeline>
</Section>

<style lang="scss">
  .project {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2rem;
  }

  hr {
    margin-top: 2rem;
    opacity: 50%;
  }
</style>