---
import Section from "../shared/Section.astro";
import Typography from "../shared/Typography.astro";
import Link from "../shared/Link.astro";
import EnvelopeSimple from 'phosphor-astro/EnvelopeSimpleLight.astro';
import GithubLogo from 'phosphor-astro/GithubLogoLight.astro';
import LinkedinLogo from 'phosphor-astro/LinkedinLogoLight.astro';
---

<Section id="intro" color="var(--color-sky)">
    <svg slot="header" width="100%" height="100%" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path d="M 0,0 L 0,40 C 40,40 60,20 100,20 L 100,0" fill="var(--background)"  opacity="0.5" />
        <path d="M 0,0 L -140,80 C -80,80 -40,10 20,10 C 80,10 120,80 180,80 L 100,0" fill="var(--background)" opacity="0.5" />
    </svg>
    <Typography as="h1" variant="hero" class="appear">Ruben Bimmel</Typography>
    <ul class="link-list">
        <li class="appear delay-step-1">
            <Link to="mailto:contact@rubenbimmel.nl">
                <EnvelopeSimple slot="icon"/>
                contact@rubenbimmel.nl
            </Link>
        </li>
        <li class="appear delay-step-2">
            <Link to="https://github.com/RubenBimmel">
                <GithubLogo slot="icon"/>
                GitHub
            </Link>
        </li>
        <li class="appear delay-step-3">
            <Link to="https://www.linkedin.com/in/rubenbimmel">
                <LinkedinLogo slot="icon"/>
                LinkedIn
            </Link>
        </li>
    </ul>
</Section>

<style lang="scss">
  .link-list {
    li {
      margin: 1rem 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.appear) {
      animation: appear 1s both ease-out;
    }

    .delay-step-1 {
      animation-delay: 200ms;
    }

    .delay-step-2 {
      animation-delay: 400ms;
    }

    .delay-step-3 {
      animation-delay: 600ms;
    }
  }

  @keyframes appear {
    from {
      transform: translateY(1rem);
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>