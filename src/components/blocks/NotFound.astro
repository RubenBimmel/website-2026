---
import Section from "../shared/Section.astro";
import GradientHeader from "../headers/GradientHeader.astro";
import Typography from "../shared/Typography.astro";
import Link from "../shared/Link.astro";
import ArrowLeft from 'phosphor-astro/ArrowLeftLight.astro';
---

<Section>
    <GradientHeader slot="header" color="rgba(256,0,0,0.1)"/>
    <Typography as="h1" variant="title">404</Typography>
    <Typography as="p" variant="body">Deze pagina bestaat niet. 🙃</Typography>
    <Link to="/">
        <ArrowLeft slot="icon"/>
        Terug naar de homepagina
    </Link>
</Section>