---
import Typography from "../shared/Typography.astro";
import Link from "../shared/Link.astro";
import GithubLogo from 'phosphor-astro/GithubLogoLight.astro';
import ArrowBendLeftUpIcon from 'phosphor-astro/ArrowBendLeftUpLight.astro';

const date = new Date().toLocaleDateString("nl");
---

<div class="footer">
    <Link to="#intro">
        <ArrowBendLeftUpIcon slot="icon"/>
        Terug naar boven
    </Link>

    <div class="footer-row">
        <Link to="https://github.com/RubenBimmel/website-2026" variant="body-small">
            <GithubLogo slot="icon"/>
            RubenBimmel/website-2026
        </Link>
        <Typography as="p" variant="body-small">Laatst bewerkt: {date}</Typography>
    </div>
</div>

<style lang="scss">
  .footer {
    display: flex;
    flex-direction: column;
    max-width: var(--max-content-width);
    margin: 5rem auto 2.5rem;
    padding: 0 2rem;
    gap: 5rem;

    &-row {
      display: flex;
      justify-content: space-between;
      opacity: 60%;
    }
  }
</style>
