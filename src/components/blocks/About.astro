---
import Section from "../shared/Section.astro";
import Typography from "../shared/Typography.astro";
import TagList from "../shared/TagList.astro";
import Tag from "../shared/Tag.astro";
---

<Section id="about" color="var(--color-grass)">
    <svg slot="header" width="100%" height="100%" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path d="M 0,0 L 0,90 C 40,90 60,70 100,70 L 100,0" fill="var(--color-sky)" />
    </svg>
    <Typography as="h1" variant="title">Over mij</Typography>
    <Typography as="p" variant="body">Meer info coming soon...</Typography>
    <TagList>
        <Tag>🎸 Muzikant</Tag>
        <Tag>🪃 Boomerang Zeeuw</Tag>
        <Tag>🧐 Perfectionist</Tag>
        <Tag>🌱 Vegetariër</Tag>
        <Tag>🎮 Gamer</Tag>
        <Tag>🌈 LHBTIQ+</Tag>
        <Tag>😶‍🌫️ Introvert</Tag>
        <Tag>☕ Cappuccino lover</Tag>
        <Tag>🚴 Wielrenner</Tag>
        <Tag>🥾 Wandelaar</Tag>
        <Tag>🎢 Pretpark Liefhebber</Tag>
    </TagList>
</Section>
