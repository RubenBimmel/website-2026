---
interface Props {
    as: 'h1' | 'h2' | 'h3' | 'p' | 'span';
    variant: 'hero' | 'title' | 'heading' | 'subheading' | 'body' | 'body-small';
    class?: string;
}

const {as, variant, class: className} = Astro.props;

const Element = as;
---

<Element class:list={[variant, className]}>
    <slot/>
</Element>

<style>
    .hero {
        font-family: "Playpen Sans", cursive;
        font-optical-sizing: auto;
        font-weight: 100;
        font-style: normal;
        font-size: 2.5rem;
        margin-bottom: 3rem;
    }
    
    .title {
        font-family: "Playpen Sans", cursive;
        font-optical-sizing: auto;
        font-weight: 100;
        font-style: normal;
        font-size: 3rem;
        margin-bottom: 3rem;
    }

    .heading {
        font-size: 1.25rem;
        font-weight: normal;
        margin-bottom: 1.5rem;
    }
    
    .subheading {
        font-size: 1.1rem;
        font-weight: bold;
        margin-bottom: 1rem;
    }

    .body {
        font-size: 1rem;
        font-weight: normal;
    }

    .body-small {
        font-size: 0.75rem;
        font-weight: normal;
    }


    @media screen and (min-width: 768px) {
        .hero {
            font-size: 4.5rem;
            margin-bottom: 4.5rem;
        }
    }
    
    @media screen and (min-width: 1080px) {
        .hero {
            font-size: 6rem;
        }

        .title {
            font-size: 4.5rem;
            margin-bottom: 4.5rem;
        }

        .heading {
            font-size: 2rem;
        }

        .subheading {
            font-size: 1.3rem;
        }

        .body {
            font-size: 1.25rem;
        }

        .body-small {
            font-size: 1rem;
        }
    }
</style>