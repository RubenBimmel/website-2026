---
interface Props {
    as: 'h1' | 'h2' | 'h3' | 'p' | 'span';
    variant: 'hero' | 'title' | 'heading' | 'subheading' | 'body';
    class?: string;
}

const {as, variant, class: className} = Astro.props;

const Element = as;
---

<Element class:list={[variant, className]}>
    <slot/>
</Element>

<style>
    .hero {
        font-family: "Playpen Sans", cursive;
        font-optical-sizing: auto;
        font-weight: 100;
        font-style: normal;
        font-size: 6rem;
        margin-bottom: 4.5rem;
    }
    
    .title {
        font-family: "Playpen Sans", cursive;
        font-optical-sizing: auto;
        font-weight: 100;
        font-style: normal;
        font-size: 4.5rem;
        margin-bottom: 4.5rem;
    }

    .heading {
        font-size: 2rem;
        font-weight: normal;
        margin-bottom: 1.5rem;
    }
    
    .subheading {
        font-size: 1.3rem;
        font-weight: bold;
        margin-bottom: 1.5rem;
    }

    .body {
        font-size: 1.25rem;
        font-weight: normal;
    }
</style>