---
interface Props {
    id: string;
}

const {id} = Astro.props;
---

<section id={id} class="section">
    <div class="background" role="presentation">
        <div class="header">
            <slot name="header"/>
        </div>
    </div>
    <div class="content">
        <slot/>
    </div>
</section>

<style lang="scss">
  .section {
    --header-height: 40vh;

    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    scroll-snap-align: start;

    .background {
      position: absolute;
      inset: 0;
      z-index: -1;

      .header {
        position: sticky;
        top: 0;
        width: 100%;
        height: var(--header-height);
      }
    }

    .content {
      width: 100%;
      max-width: var(--max-content-width);
      padding: var(--header-height) 2rem 8rem;
    }
  }
</style>