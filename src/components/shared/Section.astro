---
interface Props {
    id: string;
    color?: string;
}

const {id, color = 'var(--background)'} = Astro.props;
---

<section id={id} class="section">
    <div class="foreground" role="presentation">
        <div class="header">
            <slot name="header"/>
        </div>
    </div>
    <svg class="noise" role="presentation">
        <filter id='noiseFilter'>
            <feTurbulence
                    type='fractalNoise'
                    baseFrequency='0.65'
                    numOctaves='3'
                    stitchTiles='stitch'/>
        </filter>
        <rect width='100%' height='100%' filter='url(#noiseFilter)'/>
    </svg>
    <div class="content">
        <slot/>
    </div>
</section>

<style lang="scss" define:vars={{color}}>
  .section {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    scroll-snap-align: start;
    background-color: var(--color);
    
    .noise {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0.33;
    }

    .foreground {
      position: absolute;
      inset: 0;

      .header {
        position: sticky;
        top: 0;
        width: 100%;
        height: 100vh;
      }
    }

    .content {
      width: 100%;
      max-width: var(--max-content-width);
      padding: 30vh 2rem 12rem;
      z-index: 1;
    }
  }
</style>