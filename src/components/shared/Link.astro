---
import Typography from "./Typography.astro";

interface Props {
    to: string;
}

const {to} = Astro.props;
---

<a href={to} class="link">
    <slot name="icon"/>
    <Typography as="span" variant="body" class="link-text">
        <slot/>
    </Typography>
</a>

<style lang="scss">
    .link {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      color: currentColor;
      text-decoration: none;

      :global(svg) {
        width: 2rem;
        height: 2rem;
      }

      :global(.link-text) {
        border-bottom: 1px solid;
        border-color: transparent;
        transition: border-color 0.3s linear;
      }
      
      &:hover :global(.link-text) {
        border-color: currentColor;
      }
    }
</style>