---
import Typography from "./Typography.astro";

interface Props {
    to: string;
    variant?: 'body' | 'body-small'
}

const {to, variant = 'body'} = Astro.props;
---

<a href={to} class:list={['link', variant]} target={to.startsWith('http') ? "_blank" : undefined}>
    <slot name="icon"/>
    <Typography as="span" variant={variant} class="link-text">
        <slot/>
    </Typography>
</a>

<style lang="scss">
    .link {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      color: currentColor;
      text-decoration: none;
      opacity: 75%;
      transition: opacity 0.2s linear;

      &.body :global(svg) {
        width: 2rem;
        height: 2rem;
      }
      
      &.body-small :global(svg) {
        width: 1.25rem;
        height: 1.25rem;
      }

      :global(.link-text) {
        border-bottom: 1px solid;
        border-color: transparent;
        transition: border-color 0.3s linear;
      }
      
      &:hover {
        opacity: 100%;

        :global(.link-text) {
          border-color: currentColor;
        }
      }
    }
</style>